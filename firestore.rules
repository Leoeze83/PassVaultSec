rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regla de Notas Colaborativas y Seguras
    match /notes/{noteId} {
      
      // Función para verificar si el usuario es el dueño de la nota
      function isOwner() {
        return request.auth != null && (
          resource == null || resource.data.ownerId == request.auth.uid
        );
      }

      // Función para verificar si el usuario está invitado como colaborador
      function isCollaborator() {
        return request.auth != null && 
               resource != null && 
               (
                 ('collaboratorEmails' in resource.data && (
                    request.auth.token.email in resource.data.collaboratorEmails ||
                    request.auth.token.email.lower() in resource.data.collaboratorEmails
                 )) ||
                 ('collaborators' in resource.data && (
                    request.auth.token.email in resource.data.collaborators ||
                    request.auth.token.email.lower() in resource.data.collaborators
                 ))
               );
      }

      // Función para verificar si el colaborador tiene permisos de edición
      function isEditor() {
        return isCollaborator();
      }

      // LECTURA: El dueño o cualquier colaborador invitado (lector o editor)
      allow read: if isOwner() || isCollaborator();

      // CREACIÓN: Solo usuarios autenticados asignándose a sí mismos como ownerId
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;

      // ACTUALIZACIÓN: El dueño o los colaboradores
      allow update: if isOwner() || isCollaborator();

      // ELIMINACIÓN: Exclusiva del dueño de la nota
      allow delete: if isOwner();
    }

    // Perfiles públicos / de usuario para búsqueda de colaboradores
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Invitaciones de colaboración en tiempo real
    match /invitations/{invitationId} {
      allow read, delete: if request.auth != null && (
        resource.data.collaboratorEmail == request.auth.token.email ||
        resource.data.collaboratorEmail == request.auth.token.email.lower() ||
        resource.data.ownerEmail == request.auth.token.email ||
        resource.data.ownerEmail == request.auth.token.email.lower()
      );
      allow create, update: if request.auth != null;
    }

    // Funciones auxiliares para Zero-Trust SOC
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'leoeze83@gmail.com' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'SUPERADMIN' &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true)
      );
    }

    function isSOCAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'leoeze83@gmail.com' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true)
      );
    }

    // Registro de Administradores Autorizados (Zero-Trust & ABM del SOC)
    match /admins/{adminId} {
      // Lectura permitida si es admin del SOC o si consulta su propio documento
      allow read: if request.auth != null && (isSOCAdmin() || request.auth.uid == adminId);
      // Alta, Baja y Modificación permitida a SuperAdmin o autoprovisión del dueño
      allow create, update, delete: if isSuperAdmin() || (request.auth != null && request.auth.uid == adminId && request.auth.token.email == 'leoeze83@gmail.com');
    }

    // Telemetría de Seguridad y Métricas en Tiempo Real (Exclusivo Dashboard Privado)
    match /security_telemetry/{eventId} {
      // Clientes de cualquier dispositivo instalado pueden registrar eventos anonimizados (Write-only)
      allow create: if request.resource.data.keys().hasAll(['eventType', 'category', 'severity', 'timestamp']);
      // Solo administradores verificados en el SOC pueden leer o auditar
      allow read: if isSOCAdmin();
      allow delete: if isSuperAdmin();
    }

    // Registro y Gestión de Flota de Dispositivos Conectados (SOC)
    match /device_registry/{deviceId} {
      allow read: if isSOCAdmin();
      allow write: if isSOCAdmin();
    }
  }
}

